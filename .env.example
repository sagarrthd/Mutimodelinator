# Environment configuration example
# Copy this to .env and fill in your values

# HuggingFace Configuration
# Leave empty to use default cache location (~/.cache/huggingface/)
# HF_HOME=/path/to/models/cache
HF_TOKEN=

# Model Download Settings
# Set to 1 to download all models on first run
# AUTO_DOWNLOAD_MODELS=0

# Generation Limits
# Maximum concurrent generations
MAX_CONCURRENT_OPERATIONS=1

# VRAM Safety Margin (GB)
VRAM_SAFETY_MARGIN_GB=1

# Inference Timeout (seconds)
INFERENCE_TIMEOUT_SECONDS=600

# Server Configuration
# Server address (127.0.0.1 for local only)
SERVER_ADDRESS=127.0.0.1

# Server port
SERVER_PORT=7860

# Logging
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Output Directory
# Where to save generated images, audio, and videos
# Leave empty to use temporary directory
# OUTPUT_DIR=./outputs

# Features (for future use)
ENABLE_BATCH_GENERATION=1
ENABLE_STYLE_TRANSFER=0
ENABLE_UPSCALING=0
